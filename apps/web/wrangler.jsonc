/**
 * Cloudflare Workers config for the Money Money web app (Next.js via @opennextjs/cloudflare).
 * See docs/deployment/cloudflare-web.md. No custom domain/route is configured here.
 *
 * Secrets (never commit): `wrangler secret put CLERK_SECRET_KEY`.
 * NEXT_PUBLIC_* values are inlined at build time — set them in the build environment.
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "moneymoney-web",
  "main": ".open-next/worker.js",
  // OpenNext requires >= 2024-09-23; keep within the installed workerd's supported range.
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "moneymoney-web",
    },
  ],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/sign-in",
  },
}
