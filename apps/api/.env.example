# Money Money API — copy to apps/api/.env for local development. Placeholders only.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Local Postgres (e.g. docker run -p 5432:5432 -e POSTGRES_PASSWORD=dev postgres:17-alpine)
DATABASE_URL=postgres://postgres:dev@localhost:5432/moneymoney
MIGRATE_ON_START=true

# Clerk (dashboard → API keys). Use the development instance keys locally.
CLERK_SECRET_KEY=sk_test_xxx
# Optional networkless verification key (PEM)
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Comma-separated Clerk user ids allowed to use this private instance (required in production).
OWNER_CLERK_USER_IDS=

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=300
ENABLE_API_DOCS=true
TRUST_PROXY=false
