{
  "expo": {
    "name": "Money Money",
    "slug": "moneymoney",
    "scheme": "moneymoney",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F2F0",
    "primaryColor": "#0C0A08",
    "description": "Know your money before you spend it.",
    "ios": {
      "bundleIdentifier": "dev.necookie.moneymoney",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.necookie.moneymoney",
      "versionCode": 10001,
      "adaptiveIcon": {
        "backgroundColor": "#0C0A08",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": ["android.permission.USE_BIOMETRIC", "android.permission.USE_FINGERPRINT"]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Money Money to use Face ID to unlock the app."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Money Money to use Face ID to unlock the app."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0C0A08",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-background-task",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0C0A08"
        }
      ],
      "./plugins/with-release-signing",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager (expo-background-task) and other AndroidX libraries create their Room databases\n# by reflection (Class.getDeclaredConstructor()). R8 otherwise strips the no-arg constructor of\n# the generated *_Impl classes and the app crashes on launch in WorkManagerInitializer.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }"
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "39b81934-9693-4aac-9f67-ed9da435eb0c"
      }
    },
    "owner": "necookie"
  }
}
