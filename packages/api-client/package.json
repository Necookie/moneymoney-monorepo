{
  "name": "@mm/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed fetch client for the Money Money API (web + mobile).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@mm/types": "workspace:*",
    "@mm/validation": "workspace:*"
  },
  "devDependencies": {
    "@mm/config": "workspace:*",
    "vitest": "^5.1.0"
  }
}
